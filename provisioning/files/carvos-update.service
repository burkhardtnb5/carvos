[Unit]
Description=CARVOS Update aus dem neuesten GitHub-Release
# Wird vom Service-Modus gestartet (später carvosd), von Hand: sudo systemctl start carvos-update
# Lädt über die Schnittstelle mit Internet (eth0 oder im Service-Modus wlan0 als Client).
Wants=network-online.target
After=network-online.target time-sync.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/carvos-update online
TimeoutStartSec=20min
