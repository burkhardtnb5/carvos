[Unit]
Description=CARVOS Oberfläche (Vollbild über eglfs)
After=systemd-user-sessions.service getty@tty1.service
# Die Textkonsole auf dem Display wird nicht gebraucht und soll nicht dazwischenfunken.
Conflicts=getty@tty1.service

[Service]
User=noah
SupplementaryGroups=video render input
WorkingDirectory=/opt/carvos
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=QT_QPA_EGLFS_KMS_CONFIG=/opt/carvos/provisioning/files/eglfs-kms.json
Environment=QT_QPA_EGLFS_HIDECURSOR=1
Environment=QT_QPA_ENABLE_TERMINAL_KEYBOARD=0
ExecStart=/opt/carvos/bin/carvos-ui
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
